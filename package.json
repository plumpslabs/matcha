{
  "name": "@plumpslabs/matcha",
  "version": "2.5.8",
  "description": "Engineering philosophy ruleset — simple, efficient, deliberate. For all AI coding agents.",

  "type": "module",
  "main": "hooks/inject-rules.js",
  "bin": {
    "matcha": "./bin/matcha.js"
  },
  "scripts": {
    "check": "node scripts/check-rule-copies.js",
    "build": "node scripts/build-adapters.js",
    "build:check": "npm run build && npm run check",
    "test": "vitest run --reporter verbose",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "benchmark": "node benchmark/matcha-bench.js",
    "benchmark:json": "node benchmark/matcha-bench.js --json",
    "benchmark:agentic": "node benchmark/matcha-bench.js --agentic --iters 4",
    "benchmark:eval": "promptfoo eval",
    "benchmark:podman": "podman build -t matcha-bench -f Dockerfile.bench . && podman run --rm -v \"$PWD:/app\" matcha-bench node benchmark/matcha-bench.js --agentic --json",
    "mcp": "node hooks/matcha-mcp-server.js"
  },
  "keywords": [
    "ai-agent",
    "convention",
    "engineering",
    "claude-code",
    "cursor",
    "windsurf",
    "antigravity",
    "opencode",
    "codex",
    "kiro",
    "mcp",
    "model-context-protocol",
    "coding-standards",
    "matcha",
    "plugin",
    "language-agnostic"
  ],
  "files": [
    "skills/",
    "hooks/",
    "commands/",
    "agents/",
    "bin/",
    "scripts/",
    "plugin.json",
    "mcp_config.json",
    ".claude/",
    ".claude-plugin/",
    ".cursor/",
    ".clinerules/",
    ".windsurf/",
    ".qoder/",
    ".roo/",
    ".trae/",
    ".github/",
    ".agents/",
    ".openclaw/",
    ".opencode/",
    ".kiro/",
    ".windsurfrules",
    "gemini-extension.json",
    "AGENTS.md",
    "CLAUDE.md",
    "GEMINI.md",
    "README.md",
    "install.sh"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/plumpslabs/matcha"
  },
  "bugs": {
    "url": "https://github.com/plumpslabs/matcha/issues"
  },
  "homepage": "https://github.com/plumpslabs/matcha#readme",
  "mcp": {
    "server": "hooks/matcha-mcp-server.js",
    "tools": [
      "matcha_shield_check",
      "matcha_post_write_scan",
      "matcha_stop_tips",
      "matcha_plan_validate"
    ]
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.9",
    "vitest": "^4.1.9"
  }
}
